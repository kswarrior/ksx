# Admin server
PORT=8080

# Admin login. Defaults (testing only): kswarrior / kswarrior@123
# Change these before exposing the panel.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Admin roster (YAML). Defaults to backend/data/admins.yaml.
# Set this to point at a mounted file so roster edits apply without a rebuild.
ADMINS_FILE=

# GitHub API (use a fine-grained token with only the scopes you need)
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=

# Cloudflare API (token + account for DNS, Workers, Pages, and more)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
