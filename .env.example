# Local CLI credentials only. Never commit the real .env file.
# For Wrangler, copy this file to backend/.env (or backend/.dev.vars).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Optional Worker runtime secrets. For production, add these in the
# Cloudflare dashboard: Worker -> Settings -> Variables and Secrets.
YOUTUBE_API_KEY=
YOUTUBE_HANDLE=
DISCORD_INVITE_CODE=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_USERNAME=

# D1 is a binding, not an environment variable.
# Add it in Cloudflare: Worker -> Settings -> Bindings -> D1 database,
# variable name DB, select your database. If using Wrangler deploy,
# put the database_id in backend/wrangler.toml instead.
